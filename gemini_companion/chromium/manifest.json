{
  "manifest_version": 3,
  "name": "Langbai Gemini 图片伴侣",
  "version": "1.6.0",
  "description": "让 Langbai Image Studio 使用当前系统浏览器中的 Gemini 登录生成图片。凭据不会离开浏览器。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Langbai Gemini 图片伴侣",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "selector-pack.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
